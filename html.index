
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Portfolio ของนางสาวกมลลักษณ์ สวัสดิวงศ์">
    <title>Portfolio | Kamonlak Sawasdiwong</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- ส่วนหัวของเว็บไซต์ -->
    <header>
        <h1>สวัสดีค่ะ หนูชื่อกมลลักษณ์</h1>
        <h2>นางสาวกมลลักษณ์ สวัสดิวงศ์</h2>
        <p>ยินดีต้อนรับเข้าสู่เว็บไซต์ Portfolio ของหนู</p>
        <p>พื้นที่รวบรวมประวัติส่วนตัว ผลงาน และความภาคภูมิใจ</p>
    </header>

    <!-- เกี่ยวกับตัวเอง -->
    <section id="about">
        <h2>เกี่ยวกับฉัน</h2>
        <p>
            ดิฉันชื่อ นางสาวกมลลักษณ์ สวัสดิวงศ์
            เป็นนักเรียนระดับชั้นมัธยมศึกษาปีที่ 6
            มีความสนใจในการเรียนรู้สิ่งใหม่ ๆ
            โดยเฉพาะด้านวิทยาศาสตร์ เทคโนโลยี
            และคณิตศาสตร์
        </p>
        <p>
            ดิฉันเป็นคนที่มีความตั้งใจในการศึกษา
            ชอบพัฒนาความสามารถของตนเอง
            พร้อมเปิดรับประสบการณ์ใหม่ ๆ
            และนำความรู้ไปประยุกต์ใช้ในชีวิตประจำวัน
        </p>
    </section>

    <!-- ผลงานและเกียรติบัตร -->
    <section id="projects">
        <h2>ผลงานและความภาคภูมิใจ</h2>

        <div class="project">
            <h3>1. การอบรมให้ความรู้เกี่ยวกับยาเสพติด</h3>
            <p>
                ผ่านการอบรมให้ความรู้เกี่ยวกับยาเสพติด
                ผลกระทบและแนวทางการป้องกันยาเสพติด
                ภายใต้โครงการ TO BE NUMBER ONE
                ตำบลทุ่งใหญ่ ปีงบประมาณ 2569
            </p>
            <p>วันที่ 20 สิงหาคม พ.ศ. 2569</p>
        </div>

        <div class="project">
            <h3>2. การแข่งขันตอบปัญหาทางวิทยาศาสตร์</h3>
            <p>
                เข้าร่วมการแข่งขันตอบปัญหาทางวิทยาศาสตร์
                ระดับมัธยมศึกษาตอนปลาย
                เนื่องในกิจกรรมสัปดาห์วันวิทยาศาสตร์แห่งชาติ
                และได้รับรางวัลชนะเลิศ
            </p>
            <p>วันที่ 18 สิงหาคม พ.ศ. 2569</p>
        </div>

        <div class="project">
            <h3>3. การแข่งขันสิ่งประดิษฐ์ทางคณิตศาสตร์</h3>
            <p>
                ได้รับรางวัลระดับเหรียญทองแดง
                จากกิจกรรมการแข่งขันสิ่งประดิษฐ์ทางคณิตศาสตร์
                ระดับชั้นมัธยมศึกษาปีที่ 4–6
                ในงานศิลปหัตถกรรมนักเรียน ครั้งที่ 32
                ปีการศึกษา 2568
            </p>
            <p>วันที่ 12–13 มกราคม พ.ศ. 2569</p>
        </div>
    </section>

    <!-- ทักษะและความสามารถ -->
    <section id="skills">
        <h2>ทักษะและความสามารถ</h2>
        <ul>
            <li>ทักษะการคิดวิเคราะห์และแก้ไขปัญหา</li>
            <li>ทักษะด้านวิทยาศาสตร์และคณิตศาสตร์</li>
            <li>ความคิดสร้างสรรค์และการประดิษฐ์</li>
            <li>การทำงานร่วมกับผู้อื่น</li>
            <li>การสื่อสารและการนำเสนอ</li>
            <li>ความรับผิดชอบและการพัฒนาตนเอง</li>
        </ul>
    </section>

    <!-- เป้าหมายในอนาคต -->
    <section id="goals">
        <h2>เป้าหมายในอนาคต</h2>
        <p>
            ดิฉันตั้งใจที่จะศึกษาต่อในระดับมหาวิทยาลัย
            เพื่อพัฒนาความรู้ ความสามารถ และประสบการณ์
            นำสิ่งที่ได้เรียนรู้ไปต่อยอดในอนาคต
            และประกอบอาชีพที่ตนเองใฝ่ฝัน
            พร้อมทั้งสร้างประโยชน์ให้แก่สังคม
        </p>
    </section>

    <!-- ส่วนท้ายเว็บไซต์ -->
    <footer>
        <h2>ขอบคุณที่เข้าชม Portfolio</h2>
        <p>นางสาวกมลลักษณ์ สวัสดิวงศ์</p>
        <p>My Portfolio | Kamonlak Sawasdiwong</p>
        <p>&copy; 2026 All Rights Reserved.</p>
    </footer>

</body>
</html>
